# ============================================================================
#  Steam-Headless (CachyOS / Wayland) - configuration
#  Copy this file to ".env" and edit the values, then deploy the compose:
#      cp .env.example .env
#      docker compose up -d
#  (.env is git-ignored so your secrets never get committed.)
# ============================================================================

# ---- REQUIRED (no sensible default - you MUST set these) --------------------

# Passwords for the desktop user (noVNC) and the Sunshine web UI / Moonlight.
USER_PASSWORD=change-me
SUNSHINE_PASS=change-me

# Your NVIDIA GPU UUID.  Find it with:  nvidia-smi -L
GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Host NVIDIA driver version. Must match the host and be downloadable from
# https://download.nvidia.com/XFree86/Linux-x86_64/ .  Find it with: nvidia-smi
NVIDIA_DRIVER_VERSION=570.172.08

# Base directory on the host for persistent data. The compose creates
# <DATA_DIR>/{home,games,x11,pulse} bind mounts under it.
DATA_DIR=/mnt/pool/steam-headless

# ---- User / locale ---------------------------------------------------------

TZ=Europe/Berlin
PUID=568
PGID=568

# ---- Display (virtual output resolution) -----------------------------------
# Match this to the resolution you request in Moonlight for the sharpest image.

DISPLAY_SIZEW=2560
DISPLAY_SIZEH=1440
DISPLAY_REFRESH=60

# ---- Keyboard layout (XKB) -------------------------------------------------
# Your physical keyboard layout so Moonlight types the right characters.
# Leave VARIANT empty for the default; "nodeadkeys" makes ^ ' ` print directly.

XKB_DEFAULT_LAYOUT=de
XKB_DEFAULT_VARIANT=

# ---- Networking / web UI ---------------------------------------------------

PORT_NOVNC_WEB=31100

# ---- Steam -----------------------------------------------------------------
# false = Steam does NOT auto-start with the container. It stays installed and
# can be launched manually (terminal / menu) or via the Sunshine app
# "Steam Big Picture".
# Note: on a completely fresh home directory, false also skips the one-time
# Steam bootstrap (config.vdf / libraryfolders.vdf for /mnt/games) - so run
# once with true first.
ENABLE_STEAM=true
STEAM_ARGS=-silent

# ---- Sunshine --------------------------------------------------------------

SUNSHINE_USER=admin

# ---- Resources -------------------------------------------------------------

MEM_LIMIT=16G
MEM_RESERVATION=4G

# ---- Advanced: Wayland / NVIDIA rendering (defaults are fine for NVIDIA) ----
# gles2 (NOT vulkan) because NVIDIA's Vulkan lacks VK_EXT_external_memory_dma_buf.
WLR_RENDERER=gles2
WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128
